<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="豆瓣正在听"
        Width="460"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        ShowActivated="False"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        RenderOptions.BitmapScalingMode="HighQuality"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI">

  <Window.Resources>
    <!-- 内凹：同色底上从左上暗到右下亮的微渐变，模拟 inset 双阴影 -->
    <LinearGradientBrush x:Key="RecessedFill" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#B9C2CE" Offset="0" />
      <GradientStop Color="#D7DDE6" Offset="0.55" />
      <GradientStop Color="#EDF1F6" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="InkBrush" Color="#3D4451" />
    <SolidColorBrush x:Key="DimBrush" Color="#7B8494" />
    <SolidColorBrush x:Key="FaintBrush" Color="#9AA3B2" />
    <SolidColorBrush x:Key="BlurpleBrush" Color="#6D5DFC" />
  </Window.Resources>

  <Grid Margin="18">
    <!-- 右下冷灰阴影 -->
    <Border CornerRadius="24" Background="#E0E5EC">
      <Border.Effect>
        <DropShadowEffect Color="#B8BCC2" BlurRadius="26" ShadowDepth="8" Direction="315" Opacity="1" />
      </Border.Effect>
    </Border>

    <!-- 左上白色高光 -->
    <Border CornerRadius="24" Background="#E0E5EC">
      <Border.Effect>
        <DropShadowEffect Color="#FFFFFF" BlurRadius="18" ShadowDepth="7" Direction="135" Opacity="0.95" />
      </Border.Effect>
    </Border>

    <!-- 卡片本体 -->
    <Border x:Name="Card" CornerRadius="24" Background="#E0E5EC" Padding="24,20,24,16">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶栏 -->
        <Grid x:Name="Header" Grid.Row="0" Margin="0,0,0,16" Background="Transparent">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse x:Name="Pulse" Width="6" Height="6" Fill="#B8BCC2" Margin="0,0,8,0" VerticalAlignment="Center" />
            <TextBlock x:Name="AppName" Text="等待播放" FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource DimBrush}" />
            <TextBlock x:Name="TrackText" Text="" FontSize="12" Foreground="{StaticResource FaintBrush}"
                       VerticalAlignment="Center" Margin="8,0,0,0" MaxWidth="210"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <TextBlock x:Name="StatusText" Text="" FontSize="12" Foreground="{StaticResource FaintBrush}"
                       VerticalAlignment="Center" Margin="0,0,12,0" />
            <Border x:Name="BtnManage" Width="28" Height="28" CornerRadius="12" Background="#E0E5EC" Cursor="Hand">
              <Border.Effect>
                <DropShadowEffect Color="#B8BCC2" BlurRadius="8" ShadowDepth="3" Direction="315" Opacity="0.9" />
              </Border.Effect>
              <Grid>
                <Border CornerRadius="12" Background="#E0E5EC">
                  <Border.Effect>
                    <DropShadowEffect Color="#FFFFFF" BlurRadius="7" ShadowDepth="3" Direction="135" Opacity="0.95" />
                  </Border.Effect>
                </Border>
                <TextBlock Text="⋯" FontSize="14" Foreground="{StaticResource DimBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-4,0,0" />
              </Grid>
            </Border>
          </StackPanel>
        </Grid>

        <!-- 主体 -->
        <Grid Grid.Row="1" Margin="0,0,0,18">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="128" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Border x:Name="CoverShell" Width="128" Height="128" CornerRadius="18" Background="#D5DBE4" ClipToBounds="True">
            <Border.Effect>
              <DropShadowEffect Color="#B8BCC2" BlurRadius="12" ShadowDepth="4" Direction="315" Opacity="0.9" />
            </Border.Effect>
            <Grid>
              <TextBlock x:Name="CoverLetter" Text="♪" FontSize="32" Foreground="#AEB6C2"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
              <Image x:Name="CoverImage" Stretch="UniformToFill" />
            </Grid>
          </Border>

          <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Top">
            <TextBlock x:Name="AlbumTitle" Text="还没有在放歌" FontSize="20" FontWeight="SemiBold"
                       Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" MaxHeight="54"
                       TextTrimming="CharacterEllipsis" LineHeight="26" LineStackingStrategy="BlockLineHeight" />
            <TextBlock x:Name="ArtistLine" Text="在 Apple Music 里播放一张专辑即可" FontSize="12"
                       Foreground="{StaticResource DimBrush}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />

            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
              <TextBlock x:Name="ScoreNum" Text="—" FontSize="34" FontWeight="SemiBold"
                         Foreground="{StaticResource InkBrush}" VerticalAlignment="Bottom" />
              <TextBlock x:Name="ScoreUnit" Text="/ 10" FontSize="12" Foreground="{StaticResource FaintBrush}"
                         VerticalAlignment="Bottom" Margin="4,0,0,7" />
              <StackPanel Margin="14,0,0,0" VerticalAlignment="Bottom" >
                <Grid x:Name="DbStars" Height="12" HorizontalAlignment="Left" />
                <TextBlock x:Name="VotesLine" Text="" FontSize="12" Foreground="{StaticResource DimBrush}"
                           Margin="0,5,0,2" />
              </StackPanel>
            </StackPanel>

            <Grid x:Name="DistBar" Height="6" Margin="0,14,0,0" />
          </StackPanel>
        </Grid>

        <!-- 我的评分 -->
        <Border x:Name="MineRow" Grid.Row="2" Padding="0,4,0,0">
          <StackPanel>
            <!-- 第一行：标签 + 星级 + 右侧动作 -->
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <TextBlock Text="我的" FontSize="12" Foreground="{StaticResource FaintBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
              <StackPanel x:Name="MyStars" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" />

              <Border x:Name="BtnLater" Grid.Column="3" CornerRadius="16" Height="34" Margin="0,0,8,0"
                      Padding="13,0" Background="{StaticResource RecessedFill}"  Cursor="Hand" VerticalAlignment="Center">
                <TextBlock x:Name="BtnLaterText" Text="稍后再评" Foreground="{StaticResource FaintBrush}"
                           FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" />
              </Border>

              <Border x:Name="BtnSync" Grid.Column="4" CornerRadius="16" Height="34" Background="#6D5DFC"
                      Padding="18,0" Cursor="Hand" VerticalAlignment="Center">
                <TextBlock x:Name="BtnSyncText" Text="同步" Foreground="#FFFFFF" FontSize="12"
                           FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center" />
              </Border>
            </Grid>

            <!-- 第二行：短评独占一行 -->
            <Border CornerRadius="16" Margin="0,10,0,0" Height="34" Background="{StaticResource RecessedFill}" >
              <TextBox x:Name="CommentBox" Background="Transparent" BorderThickness="0"
                       Foreground="{StaticResource InkBrush}" CaretBrush="#6D5DFC" FontSize="12"
                       VerticalAlignment="Center" MaxLength="140" Padding="12,0,12,0"
                       VerticalContentAlignment="Center" />
            </Border>
          </StackPanel>
        </Border>

        <!-- 提示 / 进度 -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
          <TextBlock x:Name="HintText" Text="" FontSize="12" Foreground="{StaticResource FaintBrush}"
                     TextWrapping="Wrap" Visibility="Collapsed" />
          <Border x:Name="ProgressTrack" Height="4" CornerRadius="2" Background="{StaticResource RecessedFill}"
                  VerticalAlignment="Bottom" Margin="0,10,0,0">
            <Border x:Name="ProgressFill" HorizontalAlignment="Left" CornerRadius="2" Background="#6D5DFC" Width="0" />
          </Border>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
