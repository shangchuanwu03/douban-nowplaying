<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="豆瓣正在听"
        Width="460"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        ShowActivated="False"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        RenderOptions.BitmapScalingMode="HighQuality"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI">

  <Window.Resources>
    <SolidColorBrush x:Key="InkBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DimBrush" Color="#A9C0DC" />
    <SolidColorBrush x:Key="FaintBrush" Color="#6E8CB2" />
    <SolidColorBrush x:Key="ChampagneBrush" Color="#E4B863" />
    <!-- 玻璃输入：透明底 + 1px 白色 15% 描边 -->
    <Style x:Key="GlassInput" TargetType="TextBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="CaretBrush" Value="#E4B863" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
  </Window.Resources>

  <Grid Margin="18">
    <Grid>
      <!-- 夜景底 + 两团柔光斑：玻璃需要有东西可借光 -->
      <Rectangle RadiusX="24" RadiusY="24" Fill="#0B1322" />
      <Rectangle RadiusX="24" RadiusY="24">
        <Rectangle.Fill>
          <RadialGradientBrush Center="0.86,0.02" GradientOrigin="0.86,0.02" RadiusX="0.95" RadiusY="1.15">
            <GradientStop Color="#8A33517A" Offset="0" />
            <GradientStop Color="#0033517A" Offset="1" />
          </RadialGradientBrush>
        </Rectangle.Fill>
      </Rectangle>
      <Rectangle RadiusX="24" RadiusY="24">
        <Rectangle.Fill>
          <RadialGradientBrush Center="0.08,1.02" GradientOrigin="0.08,1.02" RadiusX="0.85" RadiusY="0.95">
            <GradientStop Color="#59E4B863" Offset="0" />
            <GradientStop Color="#00E4B863" Offset="1" />
          </RadialGradientBrush>
        </Rectangle.Fill>
      </Rectangle>
      <!-- 玻璃填充 8% -->
      <Rectangle RadiusX="24" RadiusY="24" Fill="#14FFFFFF" />
    </Grid>

    <Border x:Name="Card" CornerRadius="24" BorderBrush="#26FFFFFF" BorderThickness="1" Padding="22,20,22,16">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶栏 -->
        <Grid x:Name="Header" Grid.Row="0" Margin="0,0,0,16" Background="Transparent">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse x:Name="Pulse" Width="6" Height="6" Fill="#7C9CC4" Margin="0,0,8,0" VerticalAlignment="Center" />
            <TextBlock x:Name="AppName" Text="等待播放" FontSize="12" FontWeight="Medium"
                       Foreground="{StaticResource DimBrush}" />
            <TextBlock x:Name="TrackText" Text="" FontSize="12" Foreground="#7C9CC4"
                       VerticalAlignment="Center" Margin="8,0,0,0" MaxWidth="210"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <TextBlock x:Name="StatusText" Text="" FontSize="12" Foreground="{StaticResource FaintBrush}"
                       VerticalAlignment="Center" Margin="0,0,12,0" />
            <Border x:Name="BtnManage" Width="28" Height="28" CornerRadius="14" Background="#14FFFFFF"
                    BorderBrush="#26FFFFFF" BorderThickness="1" Cursor="Hand">
              <TextBlock Text="⋯" FontSize="14" Foreground="#CFE0F5"
                         HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-4,0,0" />
            </Border>
          </StackPanel>
        </Grid>

        <!-- 主体 -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="128" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Border x:Name="CoverShell" Width="128" Height="128" CornerRadius="20" Background="#16233A"
                  BorderBrush="#26FFFFFF" BorderThickness="1" ClipToBounds="True">
            <Grid>
              <TextBlock x:Name="CoverLetter" Text="♪" FontSize="32" Foreground="#5C7BA3"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
              <Image x:Name="CoverImage" Stretch="UniformToFill" />
            </Grid>
          </Border>

          <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Top">
            <TextBlock x:Name="AlbumTitle" Text="还没有在放歌" FontSize="20" FontWeight="SemiBold"
                       Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" MaxHeight="54"
                       TextTrimming="CharacterEllipsis" LineHeight="26" LineStackingStrategy="BlockLineHeight" />
            <TextBlock x:Name="ArtistLine" Text="在 Apple Music 里播放一张专辑即可" FontSize="12"
                       Foreground="{StaticResource DimBrush}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
              <TextBlock x:Name="ScoreNum" Text="—" FontSize="34" FontWeight="SemiBold"
                         Foreground="{StaticResource ChampagneBrush}" VerticalAlignment="Bottom" />
              <TextBlock x:Name="ScoreUnit" Text="/ 10" FontSize="12" Foreground="{StaticResource FaintBrush}"
                         VerticalAlignment="Bottom" Margin="4,0,0,7" />
              <StackPanel Margin="14,0,0,0" VerticalAlignment="Bottom">
                <Grid x:Name="DbStars" Height="12" HorizontalAlignment="Left" />
                <TextBlock x:Name="VotesLine" Text="" FontSize="12" Foreground="{StaticResource DimBrush}"
                           Margin="0,5,0,2" />
              </StackPanel>
            </StackPanel>

            <Grid x:Name="DistBar" Height="6" Margin="0,14,0,0" />
          </StackPanel>
        </Grid>

        <!-- 我的评分 -->
        <Border x:Name="MineRow" Grid.Row="2" Padding="0,4,0,0">
          <StackPanel>
            <!-- 第一行：标签 + 星级 + 右侧动作 -->
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <TextBlock Text="我的" FontSize="12" Foreground="#7C9CC4" VerticalAlignment="Center" Margin="0,0,10,0" />
              <StackPanel x:Name="MyStars" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" />

              <Border x:Name="BtnLater" Grid.Column="3" CornerRadius="18" Height="34" Margin="0,0,8,0"
                      Padding="13,0" Background="#0DFFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1" Cursor="Hand" VerticalAlignment="Center">
                <TextBlock x:Name="BtnLaterText" Text="稍后再评" Foreground="#7C9CC4"
                           FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" />
              </Border>

              <Border x:Name="BtnSync" Grid.Column="4" CornerRadius="18" Height="34" Background="#E4B863"
                      Padding="18,0" Cursor="Hand" VerticalAlignment="Center">
                <TextBlock x:Name="BtnSyncText" Text="同步" Foreground="#060A13" FontSize="12"
                           FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center" />
              </Border>
            </Grid>

            <!-- 第二行：短评独占一行 -->
            <Border CornerRadius="18" Margin="0,10,0,0" Height="34" Background="#0DFFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1">
              <TextBox x:Name="CommentBox" Background="Transparent" BorderThickness="0"
                       Foreground="#FFFFFF" CaretBrush="#E4B863" FontSize="12"
                       VerticalAlignment="Center" MaxLength="140" Padding="12,0,12,0"
                       VerticalContentAlignment="Center" />
            </Border>
          </StackPanel>
        </Border>

        <!-- 提示 / 进度 -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
          <TextBlock x:Name="HintText" Text="" FontSize="12" Foreground="{StaticResource FaintBrush}"
                     TextWrapping="Wrap" Visibility="Collapsed" />
          <Border x:Name="ProgressTrack" Height="4" CornerRadius="2" Background="#1FFFFFFF"
                  VerticalAlignment="Bottom" Margin="0,10,0,0">
            <Border x:Name="ProgressFill" HorizontalAlignment="Left" CornerRadius="2" Background="#E4B863" Width="0" />
          </Border>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
