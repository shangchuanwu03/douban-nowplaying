<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="豆瓣正在听"
        Width="580"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        ShowActivated="False"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        RenderOptions.BitmapScalingMode="HighQuality"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI">

  <Window.Resources>
    <SolidColorBrush x:Key="InkBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DimBrush" Color="#A9C0DC" />
    <SolidColorBrush x:Key="FaintBrush" Color="#6E8CB2" />
    <SolidColorBrush x:Key="ChampagneBrush" Color="#E4B863" />
    <!-- 玻璃输入：透明底 + 1px 白色 15% 描边 -->
    <Style x:Key="GlassInput" TargetType="TextBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="CaretBrush" Value="#E4B863" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
  </Window.Resources>

  <Grid Margin="18">
    <Grid>
      <!-- 夜景底 + 两团柔光斑：玻璃需要有东西可借光 -->
      <Rectangle RadiusX="26" RadiusY="26">
        <Rectangle.Fill>
          <LinearGradientBrush StartPoint="0.08,0" EndPoint="0.92,1">
            <GradientStop Color="#1E2A43" Offset="0" />
            <GradientStop Color="#0D1524" Offset="0.55" />
            <GradientStop Color="#0A0F1A" Offset="1" />
          </LinearGradientBrush>
        </Rectangle.Fill>
      </Rectangle>
      <Rectangle x:Name="GlowA" RadiusX="24" RadiusY="24">
        <Rectangle.Fill>
          <RadialGradientBrush Center="0.86,0.02" GradientOrigin="0.86,0.02" RadiusX="0.95" RadiusY="1.15">
            <GradientStop Color="#8AE4B863" Offset="0" />
            <GradientStop Color="#00E4B863" Offset="1" />
          </RadialGradientBrush>
        </Rectangle.Fill>
      </Rectangle>
      <Rectangle x:Name="GlowB" RadiusX="24" RadiusY="24">
        <Rectangle.Fill>
          <RadialGradientBrush Center="0.08,1.02" GradientOrigin="0.08,1.02" RadiusX="0.85" RadiusY="0.95">
            <GradientStop Color="#6633517A" Offset="0" />
            <GradientStop Color="#0033517A" Offset="1" />
          </RadialGradientBrush>
        </Rectangle.Fill>
      </Rectangle>
      <!-- 玻璃填充 8% -->
      <Rectangle RadiusX="26" RadiusY="26" Fill="#14FFFFFF" />
    </Grid>

    <Border x:Name="Card" CornerRadius="26" BorderBrush="#24FFFFFF" BorderThickness="1" Padding="22,20,22,18">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶栏 -->
        <Grid x:Name="Header" Grid.Row="0" Margin="0,0,0,16" Background="Transparent">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Grid Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center">
              <Ellipse x:Name="PulseRing" Width="6" Height="6" Stroke="#7C9CC4" StrokeThickness="1" Opacity="0"
                       HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" />
              <Ellipse x:Name="Pulse" Width="6" Height="6" Fill="#7C9CC4"
                       HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" />
            </Grid>
            <TextBlock x:Name="AppName" Text="等待播放" FontSize="12" FontWeight="Medium"
                       Foreground="{StaticResource DimBrush}" />
            <TextBlock x:Name="TrackText" Text="" FontSize="12" Foreground="#7C9CC4"
                       VerticalAlignment="Center" Margin="8,0,0,0" MaxWidth="210"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Border x:Name="StatusChip" CornerRadius="10" Background="#12FFFFFF" BorderBrush="#12FFFFFF"
                    BorderThickness="1" Padding="9,4" Margin="0,0,10,0" VerticalAlignment="Center"
                    Visibility="Collapsed">
              <TextBlock x:Name="StatusText" Text="" FontSize="12" Foreground="{StaticResource DimBrush}"
                         VerticalAlignment="Center" />
            </Border>
            <Border x:Name="BtnManage" Width="28" Height="28" CornerRadius="14" Background="#14FFFFFF"
                    BorderBrush="#26FFFFFF" BorderThickness="1" Cursor="Hand">
              <TextBlock Text="⋯" FontSize="14" Foreground="#CFE0F5"
                         HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-4,0,0" />
            </Border>
          </StackPanel>
        </Grid>

        <!-- 主体 -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Border x:Name="CoverGlow" Width="160" Height="160" CornerRadius="20" Background="#E4B863"
                  Opacity="0" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
            <Border.Effect>
              <BlurEffect Radius="26" KernelType="Gaussian" />
            </Border.Effect>
          </Border>

          <Border x:Name="CoverShell" Width="160" Height="160" CornerRadius="12" Background="#16233A"
                  BorderBrush="#24FFFFFF" BorderThickness="1" ClipToBounds="True">
            <Grid>
              <TextBlock x:Name="CoverLetter" Text="♪" FontSize="32" Foreground="#5C7BA3"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
              <Grid x:Name="Vinyl" Width="96" Height="96" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Opacity="0" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                <Ellipse Width="96" Height="96">
                  <Ellipse.Fill>
                    <RadialGradientBrush Center="0.35,0.3" GradientOrigin="0.35,0.3" RadiusX="0.85" RadiusY="0.85">
                      <GradientStop Color="#2B2B31" Offset="0" />
                      <GradientStop Color="#141418" Offset="0.45" />
                      <GradientStop Color="#07070A" Offset="1" />
                    </RadialGradientBrush>
                  </Ellipse.Fill>
                </Ellipse>
                <Ellipse Width="76" Height="76" Stroke="#1AFFFFFF" StrokeThickness="1" />
                <Ellipse Width="58" Height="58" Stroke="#14FFFFFF" StrokeThickness="1" />
                <Ellipse Width="42" Height="42" Stroke="#10FFFFFF" StrokeThickness="1" />
                <Ellipse Width="84" Height="84" Stroke="#26FFFFFF" StrokeThickness="1.2" StrokeDashArray="1.5 5" />
                <Ellipse Width="30" Height="30" Fill="#E4B863" />
                <Ellipse Width="3" Height="3" Fill="#0B0B10" />
                <Rectangle Width="2" Height="7" Fill="#B3FFFFFF" RadiusX="1" RadiusY="1"
                           HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,35,0,0" />
              </Grid>
              <Image x:Name="CoverImagePrev" Stretch="UniformToFill" Opacity="0" />
              <Image x:Name="CoverImage" Stretch="UniformToFill" Opacity="0" />
              <Rectangle x:Name="CoverSheen" Width="70" Height="190" HorizontalAlignment="Center"
                         VerticalAlignment="Center" IsHitTestVisible="False" Opacity="0.55">
                <Rectangle.Fill>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#00FFFFFF" Offset="0" />
                    <GradientStop Color="#4DFFFFFF" Offset="0.5" />
                    <GradientStop Color="#00FFFFFF" Offset="1" />
                  </LinearGradientBrush>
                </Rectangle.Fill>
                <Rectangle.RenderTransform>
                  <TransformGroup>
                    <RotateTransform Angle="18" />
                    <TranslateTransform X="-170" />
                  </TransformGroup>
                </Rectangle.RenderTransform>
              </Rectangle>

            </Grid>
          </Border>

          <StackPanel x:Name="MetaPanel" Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Top">
            <TextBlock x:Name="AlbumTitle" Text="还没有在放歌" FontSize="24" FontWeight="SemiBold"
                       Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" MaxHeight="60"
                       TextTrimming="CharacterEllipsis" LineHeight="30" LineStackingStrategy="BlockLineHeight" />
            <TextBlock x:Name="ArtistLine" Text="在 Apple Music 里播放一张专辑即可" FontSize="13"
                       Foreground="{StaticResource DimBrush}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />

            <StackPanel x:Name="ScoreLine" Orientation="Horizontal" Margin="0,12,0,0">
              <TextBlock x:Name="ScoreNum" Text="—" FontSize="46" FontWeight="SemiBold"
                         Foreground="{StaticResource ChampagneBrush}" VerticalAlignment="Bottom" />
              <TextBlock x:Name="ScoreUnit" Text="/10" FontSize="13" Foreground="{StaticResource FaintBrush}"
                         VerticalAlignment="Bottom" Margin="4,0,0,7" />
              <StackPanel Margin="14,0,0,0" VerticalAlignment="Bottom">
                <Grid x:Name="DbStars" Height="12" HorizontalAlignment="Left" />
                <TextBlock x:Name="VotesLine" Text="" FontSize="13" Foreground="{StaticResource DimBrush}"
                           Margin="0,5,0,2" />
              </StackPanel>
            </StackPanel>

            <Grid x:Name="DistBar" Margin="0,13,0,0" />
          </StackPanel>
        </Grid>

        <!-- 我的评分 -->
        <Border x:Name="MineRow" Grid.Row="2" Padding="0,14,0,0" BorderBrush="#12FFFFFF" BorderThickness="0,1,0,0">
          <StackPanel>
            <!-- 第一行：标签 + 星级 + 右侧动作 -->
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <TextBlock Text="我的" FontSize="13" Foreground="{StaticResource DimBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
              <StackPanel x:Name="MyStars" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" />

              <Border x:Name="BtnLater" Grid.Column="3" CornerRadius="18" Height="34" Margin="0,0,8,0" MinWidth="74"
                      Padding="14,0" Background="#0DFFFFFF" BorderBrush="#21FFFFFF" BorderThickness="1" Cursor="Hand" VerticalAlignment="Center">
                <TextBlock x:Name="BtnLaterText" Text="稍后再评" Foreground="{StaticResource DimBrush}"
                           FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center" />
              </Border>

              <Border x:Name="BtnSync" Grid.Column="4" CornerRadius="17" Height="34" Background="#E9EFF9"
                      Padding="16,0" MinWidth="78" Cursor="Hand" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Grid x:Name="SyncIconHost" Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center">
                    <Ellipse x:Name="SyncSpinner" Width="11" Height="11" Stroke="#A9C0DC" StrokeThickness="1.5"
                             StrokeDashArray="2 2" Visibility="Collapsed" HorizontalAlignment="Center"
                             VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" />
                    <Path x:Name="SyncCheck" Data="M1.2,6 L4.2,9 L10.5,1.8" Stroke="#E4B863" StrokeThickness="1.8"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"
                          HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" />
                  </Grid>
                  <TextBlock x:Name="BtnSyncText" Text="同步" Foreground="#0B1220" FontSize="13"
                             FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </StackPanel>
              </Border>
            </Grid>

            <!-- 第二行：短评独占一行 -->
            <Border CornerRadius="18" Margin="0,12,0,0" Height="36" Background="#0AFFFFFF" BorderBrush="#12FFFFFF" BorderThickness="1">
              <Grid>
                <TextBox x:Name="CommentBox" Background="Transparent" BorderThickness="0"
                         Foreground="#FFFFFF" CaretBrush="#E4B863" FontSize="13"
                         VerticalAlignment="Center" MaxLength="140" Padding="14,0,14,0"
                         VerticalContentAlignment="Center" />
                <TextBlock x:Name="CommentPlaceholder" Text="写一句短评…" FontSize="13" Foreground="#6E8CB2"
                           Margin="15,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
              </Grid>
            </Border>
          </StackPanel>
        </Border>

        <!-- 提示 / 进度 -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
          <TextBlock x:Name="HintText" Text="" FontSize="12" Foreground="{StaticResource FaintBrush}"
                     TextWrapping="Wrap" Visibility="Collapsed" />
          <Border x:Name="ProgressTrack" Height="2" CornerRadius="1" Background="#14FFFFFF"
                  VerticalAlignment="Bottom" Margin="0,16,0,0">
            <Border x:Name="ProgressFill" HorizontalAlignment="Left" CornerRadius="1" Background="#E4B863"
                    Width="0" RenderTransformOrigin="0,0.5" />
          </Border>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
