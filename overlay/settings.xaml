<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="豆瓣正在听 · 管理"
        Width="780" Height="680"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI">

  <Window.Resources>
    <LinearGradientBrush x:Key="RecessedFill" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#C3CAD5" Offset="0" />
      <GradientStop Color="#DDE2EA" Offset="0.5" />
      <GradientStop Color="#F0F3F8" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="InkBrush" Color="#3D4451" />
    <SolidColorBrush x:Key="DimBrush" Color="#7B8494" />
    <SolidColorBrush x:Key="FaintBrush" Color="#9AA3B2" />
  </Window.Resources>

  <Grid Margin="20">
    <Border CornerRadius="24" Background="#E0E5EC">
      <Border.Effect>
        <DropShadowEffect Color="#B8BCC2" BlurRadius="28" ShadowDepth="9" Direction="315" Opacity="1" />
      </Border.Effect>
    </Border>
    <Border CornerRadius="24" Background="#E0E5EC">
      <Border.Effect>
        <DropShadowEffect Color="#FFFFFF" BlurRadius="20" ShadowDepth="8" Direction="135" Opacity="0.95" />
      </Border.Effect>
    </Border>

    <Border x:Name="Card" CornerRadius="24" Background="#E0E5EC" Padding="28,22,28,24">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <Grid x:Name="Header" Grid.Row="0" Margin="0,0,0,18" Background="Transparent">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="TitleText" Text="豆瓣正在听" FontSize="20" FontWeight="SemiBold"
                       Foreground="{StaticResource InkBrush}" />
            <TextBlock x:Name="TitleTail" Text=" · 管理" FontSize="20" FontWeight="SemiBold"
                       Foreground="#6D5DFC" />
          </StackPanel>
          <TextBlock x:Name="StatusLine" HorizontalAlignment="Right" VerticalAlignment="Center"
                     FontSize="12" Foreground="{StaticResource FaintBrush}" Margin="0,0,46,0" />
        </Grid>

        <!-- 分段控件 -->
        <Border Grid.Row="1" x:Name="TabTrack" HorizontalAlignment="Left" Margin="0,0,0,20"
                CornerRadius="16" Background="{StaticResource RecessedFill}" Padding="5">
          <StackPanel Orientation="Horizontal">
            <Border x:Name="TabHistory" CornerRadius="12" Padding="18,8" Background="#E0E5EC" Cursor="Hand">
              <TextBlock x:Name="TabHistoryText" Text="收听史" FontSize="13" FontWeight="SemiBold"
                         Foreground="{StaticResource InkBrush}" />
            </Border>
            <Border x:Name="TabTodo" CornerRadius="12" Padding="18,8" Background="Transparent" Cursor="Hand">
              <TextBlock x:Name="TabTodoText" Text="待评分" FontSize="13" FontWeight="SemiBold"
                         Foreground="{StaticResource DimBrush}" />
            </Border>
            <Border x:Name="TabBind" CornerRadius="12" Padding="18,8" Background="Transparent" Cursor="Hand">
              <TextBlock x:Name="TabBindText" Text="手动绑定" FontSize="13" FontWeight="SemiBold"
                         Foreground="{StaticResource DimBrush}" />
            </Border>
            <Border x:Name="TabSettings" CornerRadius="12" Padding="18,8" Background="Transparent" Cursor="Hand">
              <TextBlock x:Name="TabSettingsText" Text="设置" FontSize="13" FontWeight="SemiBold"
                         Foreground="{StaticResource DimBrush}" />
            </Border>
          </StackPanel>
        </Border>

        <!-- 内容 -->
        <Grid Grid.Row="2">
          <!-- 收听史 -->
          <ScrollViewer x:Name="PanelHistory" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="HistoryList" />
          </ScrollViewer>

          <!-- 待评分 -->
          <ScrollViewer x:Name="PanelTodo" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="TodoList" />
          </ScrollViewer>

          <!-- 手动绑定 -->
          <StackPanel x:Name="PanelBind" Visibility="Collapsed">
            <Grid Margin="0,0,0,16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Border CornerRadius="16" Background="{StaticResource RecessedFill}" Height="44">
                <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0"
                         Foreground="{StaticResource InkBrush}" CaretBrush="#6D5DFC" FontSize="13"
                         VerticalContentAlignment="Center" Padding="16,0" />
              </Border>
              <Border x:Name="BtnSearch" Grid.Column="1" CornerRadius="16" Background="#6D5DFC"
                      Height="44" Padding="22,0" Margin="12,0,0,0" Cursor="Hand">
                <TextBlock Text="搜索" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold"
                           VerticalAlignment="Center" HorizontalAlignment="Center" />
              </Border>
            </Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="420">
              <StackPanel x:Name="BindResults" />
            </ScrollViewer>
          </StackPanel>

          <!-- 设置 -->
          <ScrollViewer x:Name="PanelSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock Text="播放器" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource DimBrush}"
                         Margin="2,0,0,10" />
              <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Border x:Name="ModeAuto" CornerRadius="12" Padding="16,7" Background="#E0E5EC" Cursor="Hand">
                  <TextBlock x:Name="ModeAutoText" Text="自动" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                </Border>
                <Border x:Name="ModeApple" CornerRadius="12" Padding="16,7" Margin="8,0,0,0" Background="Transparent" Cursor="Hand">
                  <TextBlock x:Name="ModeAppleText" Text="Apple Music" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource DimBrush}" />
                </Border>
                <Border x:Name="ModeSpotify" CornerRadius="12" Padding="16,7" Margin="8,0,0,0" Background="Transparent" Cursor="Hand">
                  <TextBlock x:Name="ModeSpotifyText" Text="Spotify" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource DimBrush}" />
                </Border>
                <Border x:Name="ModeNetease" CornerRadius="12" Padding="16,7" Margin="8,0,0,0" Background="Transparent" Cursor="Hand">
                  <TextBlock x:Name="ModeNeteaseText" Text="网易云" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource DimBrush}" />
                </Border>
                <Border x:Name="ModeQQ" CornerRadius="12" Padding="16,7" Margin="8,0,0,0" Background="Transparent" Cursor="Hand">
                  <TextBlock x:Name="ModeQQText" Text="QQ 音乐" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource DimBrush}" />
                </Border>
              </StackPanel>
              <TextBlock x:Name="ModeHint" Text="自动 = 谁在播就认谁；指定来源后只认这个播放器。"
                         FontSize="12" Foreground="{StaticResource DimBrush}" Margin="2,0,0,24" TextWrapping="Wrap" />

              <TextBlock Text="界面皮肤" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource DimBrush}"
                         Margin="2,0,0,10" />
              <StackPanel Orientation="Horizontal" Margin="0,0,0,26">
                <Border x:Name="SkinNeo" CornerRadius="12" Padding="18,8" Background="#E0E5EC" Cursor="Hand">
                  <Border.Effect>
                    <DropShadowEffect Color="#B8BCC2" BlurRadius="8" ShadowDepth="3" Direction="315" Opacity="0.9" />
                  </Border.Effect>
                  <TextBlock x:Name="SkinNeoText" Text="新拟物" FontSize="12" FontWeight="SemiBold"
                             Foreground="{StaticResource InkBrush}" />
                </Border>
                <Border x:Name="SkinGlass" CornerRadius="12" Padding="18,8" Margin="8,0,0,0" Background="Transparent" Cursor="Hand">
                  <TextBlock x:Name="SkinGlassText" Text="玻璃拟态" FontSize="12" FontWeight="SemiBold"
                             Foreground="{StaticResource DimBrush}" />
                </Border>
              </StackPanel>

              <TextBlock Text="豆瓣账号" FontSize="12" FontWeight="SemiBold"
                         Foreground="{StaticResource DimBrush}" Margin="2,0,0,10" />
              <Grid Margin="0,0,0,22">
                <StackPanel Orientation="Horizontal">
                  <Border x:Name="BtnLogin" CornerRadius="16" Background="#6D5DFC" Height="40" Padding="22,0" Cursor="Hand">
                    <TextBlock x:Name="BtnLoginText" Text="打开豆瓣" Foreground="#FFFFFF" FontSize="13"
                               FontWeight="SemiBold" VerticalAlignment="Center" />
                  </Border>
                  <Border x:Name="BtnClip" CornerRadius="16" Background="#E0E5EC" Height="40" Padding="16,0"
                          Margin="10,0,0,0" Cursor="Hand">
                    <TextBlock x:Name="BtnClipText" Text="从剪贴板读取" Foreground="#7B8494" FontSize="13"
                               VerticalAlignment="Center" />
                  </Border>
                  <Border x:Name="BtnLogout" CornerRadius="16" Background="#E0E5EC" Height="40" Padding="18,0"
                          Margin="10,0,0,0" Cursor="Hand" Visibility="Collapsed">
                    <TextBlock x:Name="BtnLogoutText" Text="解除绑定" Foreground="#7B8494" FontSize="13"
                               VerticalAlignment="Center" />
                  </Border>
                </StackPanel>
                <TextBlock x:Name="DoubanStatus" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Margin="0,0,8,0" MaxWidth="230" TextTrimming="CharacterEllipsis"
                           FontSize="12" Foreground="#9AA3B2" Text="未绑定" />
              </Grid>

              <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <Border x:Name="BtnImport" CornerRadius="10" Padding="2,4" Background="Transparent" Cursor="Hand">
                  <TextBlock x:Name="BtnImportText" Text="导入我在豆瓣听过的评分 →" FontSize="12"
                             FontWeight="SemiBold" Foreground="#6D5DFC" />
                </Border>
                <TextBlock x:Name="ImportHint" Margin="10,0,0,0" FontSize="12"
                           Foreground="#9AA3B2" VerticalAlignment="Center" />
              </StackPanel>

              <TextBlock Text="或手动粘贴 Cookie" FontSize="12" FontWeight="SemiBold"
                         Foreground="{StaticResource DimBrush}" Margin="2,0,0,8" />
              <Border CornerRadius="16" Background="{StaticResource RecessedFill}" Padding="2" Height="108">
                <TextBox x:Name="CookieBox" Background="Transparent" BorderThickness="0"
                         Foreground="{StaticResource InkBrush}" CaretBrush="#6D5DFC" FontSize="12.5"
                         AcceptsReturn="True" TextWrapping="Wrap" Padding="14,10"
                         VerticalScrollBarVisibility="Auto" />
              </Border>
              <TextBlock FontSize="12" Foreground="{StaticResource FaintBrush}" Margin="2,12,0,0"
                         TextWrapping="Wrap" LineHeight="22"
                         Text="① 点「打开豆瓣」用默认浏览器打开豆瓣，登录后按 F12 → 网络(Network) → 刷新页面 → 点任意 douban.com 请求 → 标头(Headers) → 请求标头里的 Cookie，右键「复制值」。② 回到这里点「从剪贴板读取」。" />
              <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                <Border x:Name="BtnSave" CornerRadius="16" Background="#6D5DFC" Height="42" Padding="24,0" Cursor="Hand">
                  <TextBlock x:Name="BtnSaveText" Text="保存" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold"
                             VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Border>
                <TextBlock x:Name="SaveHint" VerticalAlignment="Center" Margin="14,0,0,0"
                           FontSize="12" Foreground="{StaticResource FaintBrush}" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Grid>

        <!-- 关闭 -->
        <Border x:Name="BtnClose" Grid.Row="0" Width="32" Height="32" CornerRadius="12"
                Background="#E0E5EC" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="Hand">
          <Border.Effect>
            <DropShadowEffect Color="#B8BCC2" BlurRadius="8" ShadowDepth="3" Direction="315" Opacity="0.9" />
          </Border.Effect>
          <TextBlock Text="✕" FontSize="12" Foreground="{StaticResource DimBrush}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </Grid>
    </Border>
  </Grid>
</Window>
